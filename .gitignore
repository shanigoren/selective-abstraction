# Only source directories and reviewed configuration files belong in a release.
/*
!/.gitignore
!/README.md
!/LICENSE
!/RELEASE_FILES.txt
!/LICENSES/
!/THIRD_PARTY.md
!/requirements-*.txt
!/pipeline/
!/coverage/
!/correctness/
!/cache/
!/analysis/
!/scripts/
!/configs/
!/docs/
!/tests/

# Generated artifacts and local settings remain private, even inside source dirs.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*api_key*
**/*.pem
**/*.key
**/*.p12
**/*.sqlite*
**/*.db
**/*.pkl
**/*.pickle
**/*.ipynb
**/*.csv
**/*.tsv
**/*.jsonl
**/*.json
!/configs/input_manifest.json
!/pipeline/utils/model_generation_params.json
**/*.log
**/*.pdf
**/*.png
**/*.jpg
**/*.zip
**/resources/
**/results/
**/outputs/
**/runs/
**/.venv/
**/response.json
**/correctness.json
**/cost.json
**/selected_statements.json
**/*_logs.txt
**/*_responses.txt
